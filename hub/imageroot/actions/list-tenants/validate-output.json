{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-list-tenants-output.json",
  "title": "central-monitoring-hub list-tenants output",
  "type": "object",
  "required": ["tenants", "pagination"],
  "additionalProperties": false,
  "properties": {
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "customer",
          "display_name",
          "sites",
          "contact_emails",
          "token_prefix",
          "token_created_at",
          "customer_portal_enabled",
          "grafana_org_id",
          "portal_viewer_username",
          "notes",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "customer": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$"
          },
          "display_name": { "type": "string" },
          "sites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,46}[a-z0-9]$"
            }
          },
          "contact_emails": {
            "type": "array",
            "items": { "type": "string" }
          },
          "token_prefix": {
            "type": "string",
            "description": "Redacted prefix of active bearer token (e.g. cms_v1_8a9f...); full secret is never returned by list-tenants."
          },
          "token_created_at": { "type": "string" },
          "previous_token_expires_at": { "type": ["string", "null"] },
          "customer_portal_enabled": { "type": "boolean" },
          "grafana_org_id": { "type": ["integer", "null"] },
          "portal_viewer_username": { "type": "string" },
          "last_ingest_at": { "type": ["string", "null"] },
          "notes": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["page", "page_size", "total_items", "total_pages"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1 },
        "total_items": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
