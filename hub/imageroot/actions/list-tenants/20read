#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import sys

for _candidate in (
    Path(__file__).resolve().parents[2] / "pypkg",
    Path("/imageroot/pypkg"),
):
    if _candidate.is_dir() and str(_candidate) not in sys.path:
        sys.path.append(str(_candidate))

from hub_tenancy.store import list_tenants, resolve_state_dir  # noqa: E402


def main() -> None:
    raw_in = sys.stdin.read().strip()
    request = json.loads(raw_in) if raw_in else {}
    state_dir = resolve_state_dir()

    output = list_tenants(
        state_dir,
        search=str(request.get("search") or ""),
        page=int(request.get("page") or 1),
        page_size=int(request.get("page_size") or 100),
        env=os.environ,
    )
    json.dump(output, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
