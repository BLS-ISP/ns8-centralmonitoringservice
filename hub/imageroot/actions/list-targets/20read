#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import sys

_PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if _PYPKG.is_dir() and str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_alerting import ValidationFailure, emit_validation_error_and_exit
from hub_alerting.targets_manager import list_targets


def main() -> None:
    raw = sys.stdin.read().strip()
    payload = json.loads(raw) if raw else {}
    try:
        result = list_targets(payload)
    except ValidationFailure as exc:
        emit_validation_error_and_exit(exc)
    sys.stdout.write(json.dumps(result) + "\n")


if __name__ == "__main__":
    main()
