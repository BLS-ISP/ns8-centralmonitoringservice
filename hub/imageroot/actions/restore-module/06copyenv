#!/usr/bin/env python3
"""Restore module environment variables during NS8 Restic restore and flush dump_env()."""

from __future__ import annotations

import json
import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core.env_store import (  # noqa: E402
    decode_ldap_principals,
    encode_ldap_principals,
)

PRESERVED_INSTANCE_KEYS = frozenset(
    {
        "MODULE_ID",
        "MODULE_UUID",
        "NODE_ID",
        "TCP_PORT",
        "TCP_PORTS",
        "AGENT_ID",
        "AGENT_STATE_DIR",
        "AGENT_INSTALL_DIR",
    }
)


def main() -> int:
    import agent

    request = json.load(sys.stdin)
    original_env = request.get("environment")
    if isinstance(original_env, dict):
        str_env = {str(k): str(v) for k, v in original_env.items()}
        for key, value in str_env.items():
            if key in PRESERVED_INSTANCE_KEYS or key.endswith("_IMAGE"):
                continue
            agent.set_env(key, value)

        for b64_key, legacy_key, fallback in (
            ("LDAP_ADMIN_PRINCIPALS_B64", "LDAP_ADMIN_GROUP", ["Domain Admins"]),
            ("LDAP_EDITOR_PRINCIPALS_B64", "LDAP_EDITOR_GROUP", []),
            ("LDAP_VIEWER_PRINCIPALS_B64", "LDAP_VIEWER_GROUP", []),
        ):
            if not str_env.get(b64_key):
                resolved = decode_ldap_principals(
                    str_env,
                    b64_key,
                    legacy_key,
                    default_fallback=fallback,
                )
                agent.set_env(b64_key, encode_ldap_principals(resolved))

        for default_key, default_val in (
            ("MONITOR_LOCAL_NS8_NODE", "true"),
            ("LOCAL_NODE_CUSTOMER", "_msp_internal"),
            ("LOCAL_NODE_SITE", "hub"),
        ):
            if default_key not in str_env:
                agent.set_env(default_key, default_val)

    # NS8 Rule #2: Flush environment to disk immediately!
    agent.dump_env()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
