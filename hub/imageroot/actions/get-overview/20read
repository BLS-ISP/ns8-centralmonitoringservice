#!/usr/bin/env python3
"""Return lightweight operational overview for Hub Cockpit Status view."""

from __future__ import annotations

import json
import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.overview import build_get_overview_response  # noqa: E402


def main() -> int:
    response = build_get_overview_response(resolve_state_dir())
    json.dump(response, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
