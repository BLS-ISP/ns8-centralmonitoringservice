#!/usr/bin/env python3
"""Initialize NS8 module secrets, default environment, and bootstrap configs."""

import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.config_renderer import render_all_configs  # noqa: E402
from hub_core.env_store import initialize_default_env  # noqa: E402


def main() -> int:
    state_dir = resolve_state_dir()
    initialize_default_env(state_dir)
    render_all_configs(state_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
