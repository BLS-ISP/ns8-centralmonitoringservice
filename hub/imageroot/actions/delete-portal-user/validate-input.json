{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-delete-portal-user-input.json",
  "title": "central-monitoring-hub delete-portal-user input",
  "type": "object",
  "required": ["customer", "username"],
  "additionalProperties": false,
  "properties": {
    "customer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 48
    },
    "username": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._@-]{3,64}$",
      "minLength": 3,
      "maxLength": 64
    }
  }
}
