#!/usr/bin/env python3
"""Persist Hub configuration, flush dump_env(), render configs, set Traefik route, and run hooks."""

from __future__ import annotations

import json
import sys
from pathlib import Path

_IMAGEROOT = Path(__file__).resolve().parents[2]
_PYPKG = _IMAGEROOT / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.config_renderer import render_all_configs  # noqa: E402
from hub_core.env_store import (  # noqa: E402
    apply_configuration,
    build_urls,
    discover_smarthost,
)
from hub_core.local_ns8_telemetry import collect_hub_ns8_metrics  # noqa: E402
from hub_core.pod_http import reload_grafana_ldap_if_running  # noqa: E402


def main() -> int:
    import agent

    request = json.load(sys.stdin)
    state_dir = resolve_state_dir()

    try:
        env = apply_configuration(state_dir, request)
    except ValueError as exc:
        agent.set_status("validation-failed")
        err_msg = str(exc)
        err_field = (
            "local_node_customer"
            if "local_node_customer" in err_msg
            else "local_node_site"
            if "local_node_site" in err_msg
            else "grafana_admin_password"
            if "grafana_admin_password" in err_msg
            else "s3"
        )
        json.dump(
            [
                {
                    "field": err_field,
                    "parameter": err_field,
                    "value": "",
                    "error": err_msg,
                }
            ],
            sys.stdout,
        )
        sys.exit(2)

    discover_smarthost(state_dir)
    render_all_configs(state_dir)

    if env.get("MONITOR_LOCAL_NS8_NODE", "true").lower() == "true":
        collect_hub_ns8_metrics(state_dir)
    else:
        stale_prom = state_dir / "textfile" / "ns8-hub-node.prom"
        try:
            if stale_prom.is_file():
                stale_prom.unlink()
        except OSError:
            pass

    # Register HTTP ingress route in NS8 Traefik (strictly 127.0.0.1:${TCP_PORT})
    module_id = env.get("MODULE_ID", "central-monitoring-hub1")
    tcp_port = env.get("TCP_PORT", "20080")
    host = env["TRAEFIK_HOST"]
    lets_encrypt = env.get("TRAEFIK_LETS_ENCRYPT", "true").lower() == "true"
    http2https = env.get("TRAEFIK_HTTP2HTTPS", "true").lower() == "true"

    traefik_id = agent.resolve_agent_id("traefik@node")
    agent.tasks.run(
        agent_id=traefik_id,
        action="set-route",
        data={
            "instance": module_id,
            "url": f"http://127.0.0.1:{tcp_port}",
            "host": host,
            "lets_encrypt": lets_encrypt,
            "http2https": http2https,
        },
    )

    # Guarded cross-module integration hooks
    try:
        from hub_tenancy.ldap_sync import sync_ldap_config

        sync_ldap_config(state_dir, env)
    except ImportError:
        pass

    reload_grafana_ldap_if_running(state_dir, env)

    try:
        from hub_alerting.alertmanager_config import render_all_probe_configs

        render_all_probe_configs(state_dir)
    except (ImportError, AttributeError):
        pass

    try:
        from hub_alerting.alertmanager_config import sync_alertmanager

        sync_alertmanager(state_dir)
    except ImportError:
        pass

    try:
        from hub_tenancy.grafana_sync import sync_all_orgs_if_running

        sync_all_orgs_if_running(state_dir, env)
    except ImportError:
        pass

    urls = build_urls(host)
    response = {
        "status": "ok",
        "grafana_url": urls["grafana_url"],
        "ingest_metrics_url": urls["ingest_metrics_url"],
        "ingest_logs_url": urls["ingest_logs_url"],
        "storage_mode": env["STORAGE_MODE"],
    }
    json.dump(response, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
