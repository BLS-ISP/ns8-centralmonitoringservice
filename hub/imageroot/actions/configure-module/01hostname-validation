#!/usr/bin/env python3
"""NS8 Rule #4: Validate Traefik hostname collisions before mutating module state."""

import json
import os
import sys


def main() -> int:
    import agent

    request = json.load(sys.stdin)
    new_host = str(request.get("host", "")).strip().lower()
    current_host = os.environ.get("TRAEFIK_HOST", "").strip().lower()

    if new_host and new_host != current_host and agent.http_route_in_use(domain=new_host):
        agent.set_status("validation-failed")
        json.dump(
            [
                {
                    "field": "host",
                    "parameter": "host",
                    "value": new_host,
                    "error": "domain_already_used",
                }
            ],
            sys.stdout,
        )
        sys.exit(2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
