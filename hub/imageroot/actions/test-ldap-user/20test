#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import sys

for _candidate in (
    Path(__file__).resolve().parents[2] / "pypkg",
    Path("/imageroot/pypkg"),
):
    if _candidate.is_dir() and str(_candidate) not in sys.path:
        sys.path.append(str(_candidate))

from hub_tenancy.ldap_client import test_domain_user  # noqa: E402


def main() -> None:
    raw_in = sys.stdin.read().strip()
    request = json.loads(raw_in) if raw_in else {}

    output = test_domain_user(
        str(request.get("domain") or "").strip(),
        str(request.get("username") or "").strip(),
        ldap_admin_group=str(request.get("ldap_admin_group") or ""),
        ldap_editor_group=str(request.get("ldap_editor_group") or ""),
        ldap_viewer_group=str(request.get("ldap_viewer_group") or ""),
    )
    json.dump(output, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
