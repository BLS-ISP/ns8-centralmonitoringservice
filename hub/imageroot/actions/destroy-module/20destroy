#!/usr/bin/env python3
"""Remove Traefik route, stop systemd units, and delete Podman pod and volumes."""

from __future__ import annotations

import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import (  # noqa: E402
    CORE_CONTAINER_SERVICES,
    METRICS_SERVICE_UNIT,
    METRICS_TIMER_UNIT,
    POD_SERVICE,
    THANOS_SERVICES,
    resolve_state_dir,
)
from hub_core.env_store import read_module_env  # noqa: E402

MODULE_VOLUMES = (
    "prometheus-data",
    "loki-data",
    "grafana-data",
    "alertmanager-data",
    "thanos-store-data",
)


def main() -> int:
    import agent

    env = read_module_env(resolve_state_dir())
    module_id = env.get("MODULE_ID", "central-monitoring-hub1")

    try:
        traefik_id = agent.resolve_agent_id("traefik@node")
        agent.tasks.run(
            agent_id=traefik_id,
            action="delete-route",
            data={"instance": module_id},
        )
    except Exception:
        pass

    all_units = (
        METRICS_TIMER_UNIT,
        METRICS_SERVICE_UNIT,
        *THANOS_SERVICES,
        *CORE_CONTAINER_SERVICES,
        POD_SERVICE,
    )
    for unit in all_units:
        agent.run_helper("systemctl", "--user", "stop", unit)
    agent.run_helper("systemctl", "--user", "disable", *all_units)

    agent.run_helper("podman", "pod", "rm", "--ignore", "-f", "central-monitoring-hub")
    for vol in MODULE_VOLUMES:
        agent.run_helper("podman", "volume", "rm", "-f", vol)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
