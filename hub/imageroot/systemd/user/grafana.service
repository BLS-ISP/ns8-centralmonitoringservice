[Unit]
Description=Grafana OSS Multi-Org UI (Central Monitoring Hub)
BindsTo=central-monitoring-hub.service
After=central-monitoring-hub.service prometheus.service loki.service
Wants=prometheus.service loki.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/etc/defaults.env
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.cid
ExecStartPre=/usr/bin/podman run --rm --pull=missing --pod-id-file %t/central-monitoring-hub.pod-id --volume=%E/bin/wait-pod-endpoints:/wait-pod-endpoints:ro,Z --entrypoint=python3 ${CENTRAL_MONITORING_HUB_GATEWAY_IMAGE} /wait-pod-endpoints http://127.0.0.1:9090/-/ready http://127.0.0.1:3100/ready
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/%N.pid \
    --cidfile %t/%N.cid \
    --cgroups=no-conmon \
    --pod-id-file %t/central-monitoring-hub.pod-id \
    --replace -d --name grafana \
    --pull=missing \
    --restart=on-failure \
    --sdnotify=conmon \
    --user 0:0 \
    --env-file=%E/state/secrets.env \
    --volume=%E/config/grafana/grafana.ini:/etc/grafana/grafana.ini:Z \
    --volume=%E/config/grafana/ldap.toml:/etc/grafana/ldap.toml:Z \
    --volume=%E/config/grafana/provisioning:/etc/grafana/provisioning:Z \
    --volume=%E/config/grafana/dashboards:/etc/grafana/dashboards:Z \
    --volume=grafana-data:/var/lib/grafana:Z \
    ${GRAFANA_OSS_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/%N.cid -t 15
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/%N.cid
PIDFile=%t/%N.pid
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
