[Unit]
Description=Thanos Sidecar for S3 TSDB Block Upload (Central Monitoring Hub)
BindsTo=central-monitoring-hub.service
After=central-monitoring-hub.service prometheus.service
Wants=prometheus.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/etc/defaults.env
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.cid
ExecStartPre=/usr/bin/podman run --rm --pull=missing --pod-id-file %t/central-monitoring-hub.pod-id --volume=%E/bin:/hub-bin:ro,z --entrypoint=python3 ${CENTRAL_MONITORING_HUB_GATEWAY_IMAGE} /hub-bin/wait-pod-endpoints http://127.0.0.1:9090/-/ready
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/%N.pid \
    --cidfile %t/%N.cid \
    --cgroups=no-conmon \
    --pod-id-file %t/central-monitoring-hub.pod-id \
    --replace -d --name thanos-sidecar \
    --pull=missing \
    --restart=on-failure \
    --sdnotify=conmon \
    --user 0:0 \
    --volume=%E/config/thanos:/etc/thanos:ro,z \
    --volume=prometheus-data:/prometheus:z \
    ${THANOS_IMAGE} \
    sidecar \
    --tsdb.path=/prometheus \
    --prometheus.url=http://127.0.0.1:9090 \
    --objstore.config-file=/etc/thanos/objstore.yml \
    --http-address=127.0.0.1:10912 \
    --grpc-address=127.0.0.1:10911
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/%N.cid -t 15
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/%N.cid
PIDFile=%t/%N.pid
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
