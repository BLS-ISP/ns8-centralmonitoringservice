[Unit]
Description=PromQL AST Tenant Enforcer prom-label-proxy (Central Monitoring Hub)
BindsTo=central-monitoring-hub.service
After=central-monitoring-hub.service prometheus.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/etc/defaults.env
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=5
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.cid
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/%N.pid \
    --cidfile %t/%N.cid \
    --cgroups=no-conmon \
    --pod-id-file %t/central-monitoring-hub.pod-id \
    --replace -d --name prom-label-proxy \
    --pull=missing \
    --restart=on-failure \
    --sdnotify=conmon \
    --user 0:0 \
    ${PROM_LABEL_PROXY_IMAGE} \
    --label=customer \
    --header-name=X-Scope-OrgID \
    --upstream=${PROMQL_UPSTREAM_URL} \
    --insecure-listen-address=127.0.0.1:9095 \
    --enable-label-apis=true
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/%N.cid -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/%N.cid
PIDFile=%t/%N.pid
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
