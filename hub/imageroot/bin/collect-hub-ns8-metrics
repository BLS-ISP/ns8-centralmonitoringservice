#!/usr/bin/env python3
"""Collect local NS8 host and cgroups-v2 pod metrics into state/textfile/ns8-hub-node.prom."""

from __future__ import annotations

import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[1] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.env_store import read_module_env  # noqa: E402
from hub_core.local_ns8_telemetry import collect_hub_ns8_metrics  # noqa: E402


def main() -> int:
    state_dir = resolve_state_dir()
    env = read_module_env(state_dir)
    if env.get("MONITOR_LOCAL_NS8_NODE", "true").lower() != "true":
        return 0
    collect_hub_ns8_metrics(state_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
