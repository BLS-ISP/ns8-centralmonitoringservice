#!/usr/bin/env python3
"""Poll internal pod HTTP readiness endpoints with bounded timeout and retry backoff."""

from __future__ import annotations

import sys
import time
import urllib.error
import urllib.request


def wait_for_urls(urls: list[str], timeout_seconds: float = 60.0) -> bool:
    deadline = time.monotonic() + timeout_seconds
    delay = 0.5
    while time.monotonic() < deadline:
        all_ready = True
        for url in urls:
            try:
                with urllib.request.urlopen(url, timeout=2.0) as resp:  # noqa: S310 - internal pod loopback check
                    if resp.status < 200 or resp.status >= 300:
                        all_ready = False
                        break
            except (OSError, urllib.error.URLError):
                all_ready = False
                break
        if all_ready:
            return True
        time.sleep(delay)
        delay = min(2.0, delay * 1.5)
    return False


def main() -> int:
    urls = [arg for arg in sys.argv[1:] if arg.strip()]
    if not urls:
        return 0
    return 0 if wait_for_urls(urls, timeout_seconds=60.0) else 1


if __name__ == "__main__":
    raise SystemExit(main())
