#!/usr/bin/env python3
"""Remove temporary backup snapshots after Restic completes."""

import sys
from pathlib import Path

_PYPKG = Path(__file__).resolve().parents[1] / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.backup_state import cleanup_state  # noqa: E402


def main() -> int:
    cleanup_state(resolve_state_dir())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
