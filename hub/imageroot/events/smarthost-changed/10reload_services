#!/usr/bin/env python3
"""Refresh state/smarthost.env and reload Alertmanager when NS8 Smarthost changes."""

from __future__ import annotations

import sys
from pathlib import Path

_IMAGEROOT = Path(__file__).resolve().parents[2]
_PYPKG = _IMAGEROOT / "pypkg"
if str(_PYPKG) not in sys.path:
    sys.path.insert(0, str(_PYPKG))

from hub_core import resolve_state_dir  # noqa: E402
from hub_core.env_store import discover_smarthost, read_module_env  # noqa: E402
from hub_core.pod_http import pod_http_request  # noqa: E402


def main() -> int:
    state_dir = resolve_state_dir()
    discover_smarthost(state_dir)

    try:
        from hub_alerting.alertmanager_config import sync_alertmanager

        sync_alertmanager(state_dir)
    except ImportError:
        pass

    env = read_module_env(state_dir)
    if env.get("CONFIGURED", "false").lower() == "true":
        pod_http_request("http://127.0.0.1:9093/-/reload", method="POST", timeout=1.0)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
