# Enforce LF line endings across all repository text and NS8 container artifacts
* text=auto eol=lf

# Mandatory LF enforcement for NethServer 8 rootless container scripts, units, configs, and templates
**/imageroot/** text eol=lf
imageroot/** text eol=lf
**/*.sh text eol=lf
**/*.py text eol=lf
**/*.yml text eol=lf
**/*.yaml text eol=lf
**/*.alloy text eol=lf
**/*.tmpl text eol=lf
**/Containerfile text eol=lf
Containerfile text eol=lf
**/Dockerfile text eol=lf
Dockerfile text eol=lf
**/*.service text eol=lf
**/*.timer text eol=lf
**/*.conf text eol=lf
**/*.toml text eol=lf
**/*.prom text eol=lf
**/*.json text eol=lf
**/*.md text eol=lf
**/*.vue text eol=lf
**/*.js text eol=lf
**/*.css text eol=lf
**/*.scss text eol=lf
**/*.ps1 text eol=lf
**/*.robot text eol=lf

# Binary assets (last-match wins over any path globs so PNG 0D 0A headers are never mangled)
*.png binary
**/*.png binary
*.jpg binary
**/*.jpg binary
*.jpeg binary
**/*.jpeg binary
*.gif binary
**/*.gif binary
*.webp binary
**/*.webp binary
*.ico binary
**/*.ico binary
*.woff* binary
**/*.woff* binary
*.ttf binary
**/*.ttf binary
*.eot binary
**/*.eot binary
*.gz binary
*.tar binary
*.zip binary
