# NethServer 8 Rootless Module Image: central-monitoring-collector
# Packages collector/imageroot/ and collector/ui/dist/ with strict LF normalization & +x permissions.

FROM docker.io/library/alpine:3.20 AS stage-prep
COPY imageroot /imageroot
COPY ui/dist /ui
RUN find /imageroot -name "__pycache__" -type d -exec rm -rf {} + && \
    find /imageroot -name "*.pyc" -delete && \
    find /imageroot -type f -exec sed -i 's/\r$//' {} + && \
    chmod +x /imageroot/actions/*/[0-9]* /imageroot/update-module.d/* /imageroot/bin/*

FROM scratch
COPY --from=stage-prep /imageroot /imageroot
COPY --from=stage-prep /ui /ui

LABEL org.nethserver.authorizations="node:fwadm cluster:accountconsumer" \
      org.nethserver.rootfull=0 \
      org.nethserver.flags="" \
      org.nethserver.images="docker.io/grafana/alloy:v1.4.2 docker.io/prompve/prometheus-pve-exporter:3.4.5"
