#!/usr/bin/env python3
"""Stop and clean up systemd user units, firewall ports, and Podman resources on destroy-module."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

PYPKG = Path(__file__).resolve().parents[2] / "pypkg"
if str(PYPKG) not in sys.path:
    sys.path.insert(0, str(PYPKG))

from collector_lib.runtime import sync_syslog_firewall_ports

UNITS = (
    "ns8-collector-textfile.timer",
    "ns8-collector-textfile.service",
    "alloy.service",
    "pve-exporter.service",
    "central-monitoring-collector.service",
)


def main() -> int:
    prev_syslog_enabled = os.environ.get("ENABLE_SYSLOG_RECEIVER", "0") == "1"
    prev_syslog_port = int(os.environ.get("SYSLOG_PORT", "5514") or 5514)
    sync_syslog_firewall_ports(
        enable=False,
        port=prev_syslog_port,
        previous_enabled=prev_syslog_enabled,
        previous_port=prev_syslog_port,
    )

    systemctl_bin = shutil.which("systemctl")
    if systemctl_bin and os.name != "nt":
        for unit in UNITS:
            subprocess.run(
                [systemctl_bin, "--user", "disable", "--now", unit],
                capture_output=True,
                check=False,
            )

    podman_bin = shutil.which("podman")
    if podman_bin and os.name != "nt":
        subprocess.run(
            [podman_bin, "pod", "rm", "--ignore", "-f", "central-monitoring-collector"],
            capture_output=True,
            check=False,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
