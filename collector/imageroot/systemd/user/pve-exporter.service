[Unit]
Description=Proxmox VE Prometheus Exporter sidecar (pod-internal loopback :9221)
BindsTo=central-monitoring-collector.service
After=central-monitoring-collector.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=PROMETHEUS_PVE_EXPORTER_IMAGE=docker.io/prompve/prometheus-pve-exporter:3.4.5
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/pve-exporter.pid %t/pve-exporter.ctr-id
ExecStartPre=/bin/mkdir -p %E/state/pve-conf
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/pve-exporter.pid \
    --cidfile=%t/pve-exporter.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/central-monitoring-collector.pod-id \
    --replace \
    --pull=missing \
    --restart=on-failure \
    --user 0:0 \
    --name=pve-exporter \
    -v %E/state/pve-conf:/etc/prometheus:ro,z \
    ${PROMETHEUS_PVE_EXPORTER_IMAGE} \
    --config.file=/etc/prometheus/pve.yml \
    --web.listen-address=127.0.0.1:9221
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/pve-exporter.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/pve-exporter.ctr-id
PIDFile=%t/pve-exporter.pid
Type=forking

[Install]
WantedBy=default.target
