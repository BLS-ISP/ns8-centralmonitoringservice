#!/usr/bin/env python3
"""Collect local NS8 backup, container, and systemd health into ~/.config/state/textfile/ns8.prom."""

from __future__ import annotations

import sys
from pathlib import Path

PYPKG = Path(__file__).resolve().parents[1] / "pypkg"
if str(PYPKG) not in sys.path:
    sys.path.insert(0, str(PYPKG))

from collector_lib.ns8_metrics import collect_and_write_ns8_metrics
from collector_lib.runtime import get_state_dir


def main() -> int:
    state_dir = get_state_dir()
    collect_and_write_ns8_metrics(state_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
