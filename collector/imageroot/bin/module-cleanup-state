#!/usr/bin/env python3
"""Post-backup Restic cleanup hook for central-monitoring-collector."""

from __future__ import annotations

import sys
from pathlib import Path

PYPKG = Path(__file__).resolve().parents[1] / "pypkg"
if str(PYPKG) not in sys.path:
    sys.path.insert(0, str(PYPKG))

from collector_lib.runtime import get_state_dir


def main() -> int:
    state_dir = get_state_dir()
    for stale_tmp in state_dir.rglob(".*.tmp.*"):
        try:
            stale_tmp.unlink()
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
