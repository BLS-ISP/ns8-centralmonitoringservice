#!/usr/bin/env python3
"""Render ~/.config/state/config.alloy, pve.yml, snmp-auths.yml, and hub.token from module state."""

from __future__ import annotations

import os
import sys
from pathlib import Path

PYPKG = Path(__file__).resolve().parents[1] / "pypkg"
if str(PYPKG) not in sys.path:
    sys.path.insert(0, str(PYPKG))

from collector_lib.alloy_renderer import CollectorConfig, render_collector_artifacts
from collector_lib.runtime import (
    build_collector_id,
    get_state_dir,
    load_stored_auth_token,
    reload_alloy_config,
)
from collector_lib.targets_store import TargetsStore


def _load_env_map(state_dir: Path) -> dict[str, str]:
    merged: dict[str, str] = dict(os.environ)
    env_file = state_dir / "environment"
    if env_file.is_file():
        for raw_line in env_file.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            merged[k.strip()] = v.strip().strip('"').strip("'")
    return merged


def main(argv: list[str] | None = None) -> int:
    args = argv if argv is not None else sys.argv[1:]
    state_dir = get_state_dir()

    if "--reload-only" in args:
        reload_alloy_config()
        return 0

    env = _load_env_map(state_dir)
    configured = env.get("CONFIGURED", "0") == "1"
    customer = env.get("CUSTOMER", "")
    site = env.get("SITE", "")
    module_id = env.get("MODULE_ID", "central-monitoring-collector1")
    collector_id = env.get("COLLECTOR_ID", "") or build_collector_id(customer, site, module_id)

    cfg = CollectorConfig(
        configured=configured,
        hub_url=env.get("HUB_URL", ""),
        auth_token=load_stored_auth_token(state_dir),
        customer=customer,
        site=site,
        collector_id=collector_id,
        collect_local_ns8=env.get("COLLECT_LOCAL_NS8", "1") == "1",
        enable_syslog_receiver=env.get("ENABLE_SYSLOG_RECEIVER", "0") == "1",
        syslog_port=int(env.get("SYSLOG_PORT", "5514") or 5514),
        wal_max_disk_mb=int(env.get("WAL_MAX_DISK_MB", "2048") or 2048),
        tls_skip_verify=env.get("TLS_SKIP_VERIFY", "0") == "1",
    )

    store = TargetsStore(state_dir)
    render_collector_artifacts(state_dir, cfg, store.load_all())

    if "--reload" in args and configured:
        reload_alloy_config()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
