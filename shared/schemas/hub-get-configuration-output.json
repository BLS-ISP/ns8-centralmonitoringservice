{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-get-configuration-output.json",
  "title": "central-monitoring-hub get-configuration output",
  "description": "Returns Hub configuration (with secrets redacted) plus runtime component health and capacity metrics without overriding NS8's built-in get-status action.",
  "type": "object",
  "required": [
    "configured",
    "host",
    "lets_encrypt",
    "http2https",
    "retention_days",
    "retention_size_gb",
    "loki_retention_days",
    "backup_include_tsdb",
    "storage_mode",
    "s3",
    "ldap_enabled",
    "ldap_domain",
    "ldap_admin_group",
    "ldap_editor_group",
    "available_ldap_domains",
    "has_grafana_admin_password",
    "grafana_url",
    "ingest_metrics_url",
    "ingest_logs_url",
    "health"
  ],
  "additionalProperties": false,
  "properties": {
    "configured": { "type": "boolean" },
    "host": { "type": "string" },
    "lets_encrypt": { "type": "boolean" },
    "http2https": { "type": "boolean" },
    "retention_days": { "type": "integer", "minimum": 1 },
    "retention_size_gb": { "type": "integer", "minimum": 0 },
    "loki_retention_days": { "type": "integer", "minimum": 1 },
    "backup_include_tsdb": { "type": "boolean" },
    "storage_mode": { "type": "string", "enum": ["local", "s3"] },
    "s3": {
      "type": "object",
      "required": [
        "endpoint",
        "bucket",
        "region",
        "access_key",
        "has_secret_key",
        "insecure",
        "path_style"
      ],
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string" },
        "bucket": { "type": "string" },
        "region": { "type": "string" },
        "access_key": { "type": "string" },
        "has_secret_key": { "type": "boolean" },
        "insecure": { "type": "boolean" },
        "path_style": { "type": "boolean" }
      }
    },
    "ldap_enabled": { "type": "boolean" },
    "ldap_domain": { "type": "string" },
    "ldap_admin_group": { "type": "string" },
    "ldap_editor_group": { "type": "string" },
    "available_ldap_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "has_grafana_admin_password": { "type": "boolean" },
    "grafana_url": { "type": "string" },
    "ingest_metrics_url": { "type": "string" },
    "ingest_logs_url": { "type": "string" },
    "health": {
      "type": "object",
      "required": [
        "components",
        "active_tenants_count",
        "active_targets_count",
        "firing_alerts_count",
        "active_silences_count",
        "storage_usage_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "object",
          "required": [
            "hub_gateway",
            "prometheus",
            "loki",
            "grafana",
            "alertmanager",
            "prom_label_proxy",
            "blackbox_exporter",
            "snmp_exporter",
            "thanos_sidecar",
            "thanos_store",
            "thanos_query"
          ],
          "additionalProperties": false,
          "properties": {
            "hub_gateway": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "prometheus": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "loki": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "grafana": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "alertmanager": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "prom_label_proxy": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "blackbox_exporter": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "snmp_exporter": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "thanos_sidecar": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "thanos_store": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] },
            "thanos_query": { "type": "string", "enum": ["healthy", "unhealthy", "disabled"] }
          }
        },
        "active_tenants_count": { "type": "integer", "minimum": 0 },
        "active_targets_count": { "type": "integer", "minimum": 0 },
        "firing_alerts_count": { "type": "integer", "minimum": 0 },
        "active_silences_count": { "type": "integer", "minimum": 0 },
        "storage_usage_bytes": {
          "type": "object",
          "required": ["prometheus_bytes", "loki_bytes", "grafana_bytes", "total_bytes"],
          "additionalProperties": false,
          "properties": {
            "prometheus_bytes": { "type": "integer", "minimum": 0 },
            "loki_bytes": { "type": "integer", "minimum": 0 },
            "grafana_bytes": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
