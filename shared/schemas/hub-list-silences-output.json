{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-list-silences-output.json",
  "title": "central-monitoring-hub list-silences output",
  "type": "object",
  "required": ["silences"],
  "additionalProperties": false,
  "properties": {
    "silences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "starts_at",
          "ends_at",
          "created_by",
          "comment",
          "matchers"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string", "enum": ["active", "pending", "expired"] },
          "starts_at": { "type": "string" },
          "ends_at": { "type": "string" },
          "created_by": { "type": "string" },
          "comment": { "type": "string" },
          "matchers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value", "is_regex", "is_equal"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" },
                "is_regex": { "type": "boolean" },
                "is_equal": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
