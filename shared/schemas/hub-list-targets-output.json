{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-list-targets-output.json",
  "title": "central-monitoring-hub list-targets output",
  "type": "object",
  "required": ["targets", "pagination"],
  "additionalProperties": false,
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "enabled",
          "target_type",
          "customer",
          "site",
          "device_role",
          "scrape_interval",
          "endpoints"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "target_type": {
            "type": "string",
            "enum": ["ns8-federation", "exporter", "blackbox", "snmp"]
          },
          "customer": { "type": "string" },
          "site": { "type": "string" },
          "device_role": {
            "type": "string",
            "enum": [
              "ns8",
              "linux",
              "windows",
              "proxmox",
              "web",
              "snmp-network",
              "snmp-ups",
              "snmp-nas",
              "snmp-firewall",
              "snmp-printer"
            ]
          },
          "scrape_interval": { "type": "string" },
          "endpoints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scheme": { "type": "string", "enum": ["http", "https"] },
          "metrics_path": { "type": "string" },
          "tls_skip_verify": { "type": "boolean" },
          "basic_auth_user": { "type": "string" },
          "has_secret": { "type": "boolean" },
          "match_selectors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blackbox_module": { "type": "string" },
          "snmp_module": {
            "type": "string",
            "enum": ["", "if_mib", "apcupsd", "synology", "qnap", "mikrotik", "fortigate", "printer", "generic"]
          },
          "snmp_version": { "type": "string" },
          "snmp_v3": {
            "type": ["object", "null"],
            "required": ["username", "security_level"],
            "additionalProperties": false,
            "properties": {
              "username": { "type": "string" },
              "security_level": {
                "type": "string",
                "enum": ["noAuthNoPriv", "authNoPriv", "authPriv"]
              },
              "auth_protocol": {
                "type": "string",
                "enum": ["MD5", "SHA", "SHA224", "SHA256", "SHA384", "SHA512"]
              },
              "priv_protocol": {
                "type": "string",
                "enum": ["DES", "AES", "AES192", "AES256"]
              }
            }
          },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["page", "page_size", "total_items", "total_pages"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1 },
        "total_items": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
