{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-test-alert-input.json",
  "title": "central-monitoring-hub test-alert input",
  "type": "object",
  "required": ["channel"],
  "additionalProperties": false,
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "all",
        "smarthost_email",
        "webhook_psa",
        "teams",
        "slack",
        "push",
        "customer_email"
      ]
    },
    "customer": {
      "type": "string",
      "pattern": "^(|[a-z0-9][a-z0-9-]{1,46}[a-z0-9])$",
      "default": "",
      "description": "Tenant slug used when testing per-customer email routing."
    }
  }
}
