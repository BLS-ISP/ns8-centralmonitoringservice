{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nethserver.org/schemas/central-monitoring/hub-create-silence-input.json",
  "title": "central-monitoring-hub create-silence input",
  "description": "Creates an Alertmanager maintenance window (silence) scoped to a customer, site, device_role, and/or explicit label matchers, persisted locally for Restic backup durability.",
  "type": "object",
  "required": ["starts_at", "ends_at", "created_by", "comment"],
  "additionalProperties": false,
  "properties": {
    "customer": {
      "type": "string",
      "pattern": "^(\\*|[a-z0-9][a-z0-9-]{1,46}[a-z0-9])$",
      "default": "*",
      "description": "Tenant slug to silence, or '*' for a global MSP maintenance window."
    },
    "site": {
      "type": "string",
      "pattern": "^(|[a-z0-9][a-z0-9-]{0,46}[a-z0-9])$",
      "default": ""
    },
    "device_role": {
      "type": "string",
      "enum": [
        "",
        "ns8",
        "linux",
        "windows",
        "proxmox",
        "web",
        "snmp-network",
        "snmp-ups",
        "snmp-nas",
        "snmp-firewall",
        "snmp-printer"
      ],
      "default": ""
    },
    "extra_matchers": {
      "type": "array",
      "default": [],
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
            "maxLength": 128
          },
          "value": { "type": "string", "minLength": 1, "maxLength": 256 },
          "is_regex": { "type": "boolean", "default": false },
          "is_equal": { "type": "boolean", "default": true }
        }
      }
    },
    "starts_at": {
      "type": "string",
      "minLength": 19,
      "maxLength": 40,
      "description": "RFC3339 / ISO-8601 UTC start timestamp (e.g. 2026-11-21T02:00:00Z)."
    },
    "ends_at": {
      "type": "string",
      "minLength": 19,
      "maxLength": 40,
      "description": "RFC3339 / ISO-8601 UTC end timestamp (must be strictly after starts_at)."
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "comment": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    }
  }
}
