// ============================================================================
// NS8 Central Monitoring Service — Standalone Grafana Alloy Config (Linux)
// Template: shared/alloy-templates/config-linux.alloy.tmpl
// Tenant:   {{CUSTOMER}} | Site: {{SITE}} | Collector: {{COLLECTOR_ID}}
// Hub URL:  {{HUB_URL}}
// ============================================================================

logging {
  level  = "info"
  format = "logfmt"
}

// ----------------------------------------------------------------------------
// 1. Local Linux Host Metrics (built-in node_exporter equivalent)
// ----------------------------------------------------------------------------
prometheus.exporter.unix "local_host" {
  enable_collectors = ["systemd", "processes"]

  textfile {
    directory = "/var/lib/alloy/textfile"
  }
}

discovery.relabel "linux_host" {
  targets = prometheus.exporter.unix.local_host.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "customer"
    replacement  = "{{CUSTOMER}}"
  }

  rule {
    target_label = "site"
    replacement  = "{{SITE}}"
  }

  rule {
    target_label = "device_role"
    replacement  = "linux"
  }

  rule {
    target_label = "collector_id"
    replacement  = "{{COLLECTOR_ID}}"
  }
}

prometheus.scrape "linux_host" {
  targets         = discovery.relabel.linux_host.output
  job_name        = "node_exporter"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.hub.receiver]
}

// ----------------------------------------------------------------------------
// 2. Local Linux Systemd Journal Logs -> Hub Loki
// ----------------------------------------------------------------------------
discovery.relabel "journal_labels" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
}

loki.source.journal "systemd_journal" {
  max_age       = "12h"
  relabel_rules = discovery.relabel.journal_labels.rules
  labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "linux",
    collector_id = "{{COLLECTOR_ID}}",
    job          = "systemd-journal",
  }
  forward_to = [loki.process.linux_logs.receiver]
}

loki.process "linux_logs" {
  stage.static_labels {
    values = {
      instance = constants.hostname,
    }
  }

  forward_to = [loki.write.hub.receiver]
}

