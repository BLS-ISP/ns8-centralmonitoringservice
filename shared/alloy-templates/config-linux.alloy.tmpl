// ----------------------------------------------------------------------------
// 4. WAL-Backed Remote Delivery to Central Monitoring Hub (HTTPS + Bearer Auth)
// ----------------------------------------------------------------------------
prometheus.remote_write "hub" {
  external_labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "linux",
    collector_id = "{{COLLECTOR_ID}}",
  }

  endpoint {
    url          = "{{HUB_URL}}/api/v1/write"
    bearer_token = "{{AUTH_TOKEN}}"

    queue_config {
      capacity             = 10000
      max_shards           = 10
      min_shards           = 1
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      min_backoff          = "500ms"
      max_backoff          = "5m"
      retry_on_http_429    = true
    }
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

loki.write "hub" {
  external_labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    collector_id = "{{COLLECTOR_ID}}",
  }

  endpoint {
    url                 = "{{HUB_URL}}/loki/api/v1/push"
    bearer_token        = "{{AUTH_TOKEN}}"
    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = 0
  }

  wal {
    enabled         = true
    max_segment_age = "2h"
  }
}
