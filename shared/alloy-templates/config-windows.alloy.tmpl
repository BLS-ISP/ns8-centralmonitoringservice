// ============================================================================
// NS8 Central Monitoring Service — Standalone Grafana Alloy Config (Windows)
// Template: shared/alloy-templates/config-windows.alloy.tmpl
// Tenant:   {{CUSTOMER}} | Site: {{SITE}} | Collector: {{COLLECTOR_ID}}
// Hub URL:  {{HUB_URL}}
// ============================================================================

logging {
  level  = "info"
  format = "logfmt"
}

// ----------------------------------------------------------------------------
// 1. Local Windows Server Metrics (built-in windows_exporter)
//    Note: Add "ad", "dns", "smb" to enabled_collectors on Domain Controllers
//    or File Servers for Active Directory, DNS, and SMB share telemetry.
// ----------------------------------------------------------------------------
prometheus.exporter.windows "local_windows" {
  enabled_collectors = [
    "cpu",
    "cs",
    "logical_disk",
    "memory",
    "net",
    "os",
    "service",
    "system",
    "textfile",
    "time",
  ]
}

discovery.relabel "windows_host" {
  targets = prometheus.exporter.windows.local_windows.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "customer"
    replacement  = "{{CUSTOMER}}"
  }

  rule {
    target_label = "site"
    replacement  = "{{SITE}}"
  }

  rule {
    target_label = "device_role"
    replacement  = "windows"
  }

  rule {
    target_label = "collector_id"
    replacement  = "{{COLLECTOR_ID}}"
  }
}

prometheus.scrape "windows_host" {
  targets         = discovery.relabel.windows_host.output
  job_name        = "windows_exporter"
  scrape_interval = "30s"
  scrape_timeout  = "15s"
  forward_to      = [prometheus.remote_write.hub.receiver]
}

// ----------------------------------------------------------------------------
// 2. Windows Event Logs (Application, System, Security) -> Hub Loki
// ----------------------------------------------------------------------------
loki.source.windowsevent "application" {
  eventlog_name          = "Application"
  use_incoming_timestamp = true
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\bookmark-application.xml"
  labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "windows",
    collector_id = "{{COLLECTOR_ID}}",
    channel      = "Application",
    job          = "windows-eventlog",
  }
  forward_to = [loki.process.windows_logs.receiver]
}

loki.source.windowsevent "system" {
  eventlog_name          = "System"
  use_incoming_timestamp = true
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\bookmark-system.xml"
  labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "windows",
    collector_id = "{{COLLECTOR_ID}}",
    channel      = "System",
    job          = "windows-eventlog",
  }
  forward_to = [loki.process.windows_logs.receiver]
}

loki.source.windowsevent "security" {
  eventlog_name          = "Security"
  xpath_query            = "*[System[(Level=1 or Level=2 or Level=3 or EventID=4625 or EventID=4720 or EventID=4726 or EventID=4740)]]"
  use_incoming_timestamp = true
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\bookmark-security.xml"
  labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "windows",
    collector_id = "{{COLLECTOR_ID}}",
    channel      = "Security",
    job          = "windows-eventlog",
  }
  forward_to = [loki.process.windows_logs.receiver]
}

loki.process "windows_logs" {
  stage.json {
    expressions = {
      level  = "levelText",
      source = "source",
    }
  }

  stage.labels {
    values = {
      level  = "",
      source = "",
    }
  }

  stage.static_labels {
    values = {
      instance = constants.hostname,
    }
  }

  forward_to = [loki.write.hub.receiver]
}

// ----------------------------------------------------------------------------
// 3. WAL-Backed Remote Delivery to Central Monitoring Hub (HTTPS + Bearer Auth)
// ----------------------------------------------------------------------------
prometheus.remote_write "hub" {
  external_labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    device_role  = "windows",
    collector_id = "{{COLLECTOR_ID}}",
  }

  endpoint {
    url          = "{{HUB_URL}}/api/v1/write"
    bearer_token = "{{AUTH_TOKEN}}"

    queue_config {
      capacity             = 10000
      max_shards           = 10
      min_shards           = 1
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
      min_backoff          = "500ms"
      max_backoff          = "5m"
      retry_on_http_429    = true
    }
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

loki.write "hub" {
  external_labels = {
    customer     = "{{CUSTOMER}}",
    site         = "{{SITE}}",
    collector_id = "{{COLLECTOR_ID}}",
  }

  endpoint {
    url                 = "{{HUB_URL}}/loki/api/v1/push"
    bearer_token        = "{{AUTH_TOKEN}}"
    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = 0
  }

  wal {
    enabled         = true
    max_segment_age = "2h"
  }
}
