      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (customer, site, device_role, instance) (up{customer=~\"$customer\", site=~\"$site\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(100 - (avg by (customer, site, device_role, instance) (rate(node_cpu_seconds_total{customer=~\"$customer\", site=~\"$site\", mode=\"idle\"}[5m])) * 100)) or (100 - (avg by (customer, site, device_role, instance) (rate(windows_cpu_time_total{customer=~\"$customer\", site=~\"$site\", mode=\"idle\"}[5m])) * 100))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(avg by (customer, site, device_role, instance) ((1 - (node_memory_MemAvailable_bytes{customer=~\"$customer\", site=~\"$site\"} / (node_memory_MemTotal_bytes{customer=~\"$customer\", site=~\"$site\"} > 0))) * 100)) or (avg by (customer, site, device_role, instance) (100 * (1 - (windows_memory_available_bytes{customer=~\"$customer\", site=~\"$site\"} / ((windows_memory_physical_total_bytes{customer=~\"$customer\", site=~\"$site\"} or windows_cs_physical_memory_bytes{customer=~\"$customer\", site=~\"$site\"} or windows_os_visible_memory_bytes{customer=~\"$customer\", site=~\"$site\"}) > 0)))))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (customer, site, device_role, instance) (((1 - (node_filesystem_avail_bytes{customer=~\"$customer\", site=~\"$site\", fstype!~\"tmpfs|devtmpfs|squashfs|iso9660|overlay|fuse.*|nsfs\", mountpoint!~\"/run.*|/snap.*|/var/lib/containers/storage/overlay.*\"} / (node_filesystem_size_bytes{customer=~\"$customer\", site=~\"$site\", fstype!~\"tmpfs|devtmpfs|squashfs|iso9660|overlay|fuse.*|nsfs\", mountpoint!~\"/run.*|/snap.*|/var/lib/containers/storage/overlay.*\"} > 0))) * 100) or ((1 - (windows_logical_disk_free_bytes{customer=~\"$customer\", site=~\"$site\", volume=~\"[A-Z]:\"} / (windows_logical_disk_size_bytes{customer=~\"$customer\", site=~\"$site\", volume=~\"[A-Z]:\"} > 0))) * 100))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "D",
          "format": "table"
        }
      ],
      "title": "Flotten-Gesundheitsmatrix (Status, CPU, RAM, Disk & Direkt-Drill-Down)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "CPU %",
              "Value #C": "RAM %",
