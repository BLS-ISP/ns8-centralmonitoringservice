          "editorMode": "code",
          "expr": "100 * (1 - (windows_memory_available_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"} / ((windows_memory_physical_total_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"} or windows_cs_physical_memory_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"} or windows_os_visible_memory_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"}) > 0)))",
          "legendFormat": "[Win] {{customer}}/{{site}} - {{instance}}",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
