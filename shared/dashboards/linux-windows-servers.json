      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(1 - (node_memory_MemAvailable_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"} / (node_memory_MemTotal_bytes{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\"} > 0))) * 100",
