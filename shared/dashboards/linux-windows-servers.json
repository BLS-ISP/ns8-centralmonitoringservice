      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 - (avg by (customer, site, instance) (rate(node_cpu_seconds_total{customer=~\"$customer\", site=~\"$site\", instance=~\"$instance\", mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "[Linux] {{customer}}/{{site}} - {{instance}}",
